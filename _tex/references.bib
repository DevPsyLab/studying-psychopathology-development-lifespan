@Article{Krueger2021,
  author  = {Krueger, Robert F. and Hobbs, Kelsey A. and Conway, Christopher C. and Dick, Danielle M. and Dretsch, Michael N. and Eaton, Nicholas R. and Forbes, Miriam K. and Forbush, Kelsie T. and Keyes, Katherine M. and Latzman, Robert D. and Michelini, Giorgia and Patrick, Christopher J. and Sellbom, Martin and Slade, Tim and South, Susan C. and Sunderland, Matthew and Tackett, Jennifer L. and Waldman, Irwin and Waszczuk, Monika A. and Wright, Aidan G. C. and Zald, David H. and Watson, David and Kotov, Roman and HiTOP Utility Workgroup},
