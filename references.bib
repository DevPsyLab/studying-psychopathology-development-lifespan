@Article{Tiego2023,
  author   = {Tiego, Jeggan and Martin, Elizabeth A. and DeYoung, Colin G. and Hagan, Kelsey and Cooper, Samuel E. and Pasion, Rita and Satchell, Liam and Shackman, Alexander J. and Bellgrove, Mark A. and Fornito, Alex and Abend, Rany and Goulter, Natalie and Eaton, Nicholas R. and Kaczkurkin, Antonia N. and Nusslock, Robin and {the HiTOP Neurobiological Foundations Work Group}},
  journal  = {Nature Mental Health},
  title    = {Precision behavioral phenotyping as a strategy for uncovering the biological correlates of psychopathology},
  year     = {2023},
  number   = {5},
  pages    = {304–315},
  volume   = {1},
  abstract = {Our capacity to measure diverse aspects of human biology has developed rapidly in the past decades, but the rate at which these techniques have generated insights into the biological correlates of psychopathology has lagged far behind. The slow progress is partly due to the poor sensitivity, specificity and replicability of many findings in the literature, which have in turn been attributed to small effect sizes, small sample sizes and inadequate statistical power. A commonly proposed solution is to focus on large, consortia-sized samples. Yet it is abundantly clear that increasing sample sizes will have a limited impact unless a more fundamental issue is addressed: the precision with which target behavioral phenotypes are measured. Here, we discuss challenges, outline several ways forward and provide worked examples to demonstrate key problems and potential solutions. A precision phenotyping approach can enhance the discovery and replicability of associations between biology and psychopathology.},
  doi      = {10.1038/s44220-023-00057-5},
  url      = {https://doi.org/10.1038/s44220-023-00057-5},
}

