@Article{Moss1964,
  author   = {Moss, Howard A. and Kagan, Jerome},
  journal  = {Vita Humana},
  title    = {Report on personality consistency and change from the {Fels Longitudinal Study}},
  year     = {1964},
  number   = {2},
  pages    = {127–138},
  volume   = {7},
  abstract = {[The assumptions studied here were that certain adult behaviors are established at an early age and that early maternal treatment is an important predictor of personality development. The subjects were 36 males and 35 females. Longitudinal reports were used for rating each subject for aggressive, achievement, and passive-dependent behavior for four childhood age periods. The mothers' treatment of the child was also rated for each period. A second rater independently evaluated these subjects when they were adults, using interview material and comparable variables. The results consisted of correlations between the childhood and adult ratings and showed that childhood aggression predicted adult aggression only for males. Childhood passive-dependent behavior predicted similar adult behaviors only for females. Achievement behavior was stable for both sexes. The second major finding was that maternal treatment for the 0–3 age period was more predictive of the child and adult ratings than later maternal ratings.]},
  doi      = {10.1159/000270073},
  url      = {http://www.jstor.org/stable/26761430},
}

